# Database
DATABASE_URL="connection-string-for-your-database"

# Auth.js (next-auth)
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Widget JWT — separate secret for visitor tokens
WIDGET_JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP or Resend SMTP relay)
# For Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<api_key>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourdomain.com"
